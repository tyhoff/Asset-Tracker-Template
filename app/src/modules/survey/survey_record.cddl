; Radio survey record and session header.
; ---------------------------------------
; One record per capture cycle: a GNSS fix bracketing pair plus the cell and Wi-Fi
; observations seen between them. Decoded off-device by scripts/survey_decode.py, which
; dispatches on the version field.
;
; Conventions, all of which the host decoder relies on:
;
; - Map keys are integers, not strings. A record is written thousands of times per drive
;   and never read by a human in this form.
; - Optional fields are OMITTED when not measured, never encoded as 0 or a sentinel. Zero
;   is a plausible reading for several of these (rsrq, timeDiff, heading, altitude), so an
;   encoded 0 must always mean "measured 0".
; - MAC addresses are 6-byte binary strings, not text.
; - Field names follow the nRF Cloud ground-fix API (https://api-docs.nrfcloud.com/) so the
;   decoder's output is close to identity: lte[] carries mcc/mnc/eci/tac/earfcn/pci/rsrp/
;   rsrq/adv with nmr[] neighbours, wifi.accessPoints[] carries macAddress/signalStrength/
;   channel/frequency.
; - rsrp and rsrq are stored as the 3GPP INDEX values the modem reports, not dBm. The
;   decoder converts. Storing the index keeps them small and lossless. The indices are
;   SIGNED -- see the note on rsrp-idx.
; - frequency is NOT stored for Wi-Fi. It is a pure function of (band, channel), so the
;   decoder derives it with the same mapping the firmware uses for display.
;
; Timestamps: one absolute epoch-millisecond base per record, then small signed deltas from
; that base for the other five. At a 10 s cadence every delta fits in two bytes, where five
; more absolute epoch-ms values would cost six bytes each.
;
; VERSION HISTORY
;   1  Initial schema.
;      Key 18 (ap-dropped) was added later without a version bump. It is optional, so
;      records written before it existed decode unchanged -- absent means "this build did
;      not filter", which is exactly what those records represent. A bump would have
;      invalidated the partition for no gain.

; --- Session header ---------------------------------------------------------------------
;
; Written once at the start of an export, before any records, so a dataset is attributable
; and reproducible. Carries its own version: the header format and the record format can
; move independently.

survey-session = {
    1 => version,             ; must match the record version
    2 => device-id,
    3 => app-version,
    4 => modem-version,       ; e.g. "mfw_nrf91x1_2.0.4"
    ? 5 => exported-at,       ; epoch ms; omitted if the clock was never set
}

device-id = tstr
app-version = tstr
modem-version = tstr
exported-at = uint .size 8

; --- Record -----------------------------------------------------------------------------

; Scalars are given names rather than written inline: zcbor derives C member names from the
; type, so an inline "1 => uint" becomes a member called uint1uint.
version = uint .size 2
sequence = uint .size 4
t-base = uint .size 8
cell-start-ms = int .size 4
cell-end-ms = int .size 4
wifi-start-ms = int .size 4
wifi-end-ms = int .size 4
gnss-after-ms = int .size 4

survey-record = {
    1 => version,
    2 => sequence,            ; monotonic within a session
    3 => profile,
    4 => time-base,
    5 => t-base,              ; absolute epoch ms, or uptime ms if time-base is 1

    ; Bracketing GNSS fixes. Both are optional because a cycle whose fix failed is still
    ; worth keeping -- the radio observations remain valid, they just cannot be scored.
    ; The decoder interpolates ground truth to the scan midpoint and refuses to when a
    ; bracket is missing.
    ? 6 => gnss-fix-before,
    ? 7 => gnss-fix-after,

    ; Deltas from t-base in milliseconds. Signed: t-base is the first GNSS fix, so a value
    ; can legitimately precede it if the clock is stepped mid-cycle by a GNSS time update.
    ? 8 => cell-start-ms,
    ? 9 => cell-end-ms,
    ? 10 => wifi-start-ms,
    ? 11 => wifi-end-ms,
    ? 12 => gnss-after-ms,

    ? 13 => serving-cell,
    ? 14 => [* neighbour],    ; nmr[]
    ? 15 => [* gci-cell],     ; GCI full-identity cells
    ? 16 => [* access-point], ; wifi.accessPoints[]
    ? 17 => network-mode,

    ; How many access points the BSSID filter removed before the list above was built.
    ; Omitted when none were, so it costs nothing on a clean scan.
    ;
    ; Recorded because the filter is destructive and irreversible: the unfiltered scan
    ; exists only for the lifetime of one zbus callback. Without this, a train carriage
    ; where 8 of 10 access points were randomised and an empty lab with 2 are identical on
    ; the wire, and the evidence to tell them apart was discarded weeks before anyone
    ; looked at the data. It is also the only way to notice the filter misbehaving after
    ; the fact.
    ? 18 => ap-dropped,
}

; 0 = FAST, 1 = DEEP.
profile = uint .size 1

; The wire values are enum survey_time_base, written through unchanged:
;   0 = unset. No timestamp was ever recorded.
;   1 = milliseconds since boot, because the clock was never synchronised. The decoder
;       must treat those records as unusable for accuracy scoring.
;   2 = Unix epoch, correlatable with anything off-device.
; Ordering follows the C enum rather than putting Unix first: the enum is the source of
; truth because the encoder casts it straight onto the wire.
time-base = uint .size 1

; 0 = unknown, 1 = LTE-M, 2 = NB-IoT.
network-mode = uint .size 1

; Bounded by the modem's scan result count, so one byte on the wire in every real case.
ap-dropped = uint .size 2

; --- Components -------------------------------------------------------------------------

; Position, named as in the nRF Cloud GNSS device message.
; lat/lon are scaled integers rather than floats: 1e-7 degrees is ~11 mm, far finer than
; GNSS accuracy, and costs 4 bytes against 8 for a double.
; zcbor derives generated function names from the type name, so a type used at two keys
; collides. These aliases keep the schema single-sourced while giving each use its own name.
gnss-fix-before = gnss-fix
gnss-fix-after = gnss-fix
serving-cell = cell
gci-cell = cell

gnss-fix = {
    1 => lat-e7,              ; degrees * 1e7
    2 => lon-e7,              ; degrees * 1e7
    3 => acc-mm,              ; horizontal accuracy, millimetres
    ? 4 => alt-mm,            ; millimetres above ellipsoid
    ? 5 => spd-mmps,          ; millimetres per second
    ? 6 => hdg-cdeg,          ; degrees * 100
    ? 7 => sats-used,
}

lat-e7 = int .size 4
lon-e7 = int .size 4
acc-mm = uint .size 4
alt-mm = int .size 4
spd-mmps = uint .size 4
hdg-cdeg = uint .size 2
sats-used = uint .size 1

; An identified cell: serving, or an entry of the GCI list. pci is deliberately absent --
; mcc/mnc/eci/tac identify the cell globally, so the physical cell ID adds nothing a lookup
; can use. Neighbours, which have no identity, do carry it.
cell = {
    1 => eci,
    2 => mcc,
    3 => mnc,
    4 => tac,
    ? 5 => earfcn,
    ? 6 => rsrp-idx,          ; 3GPP index
    ? 7 => rsrq-idx,          ; 3GPP index
    ? 8 => adv,               ; timing advance. Usually absent -- see FW-3.
}

eci = uint .size 4
mcc = uint .size 2
mnc = uint .size 2
tac = uint .size 4
earfcn = uint .size 4
; SIGNED, not unsigned. lte_lc.h documents the 3GPP index ranges as RSRP -17..97 and
; RSRQ -30..46 -- the negative half is where a cell-edge measurement lives, which is
; exactly the population this survey exists to characterise. A uint here does not merely
; clip the value: zcbor range-guards it, so one negative neighbour reading fails
; cbor_encode_survey_record and discards the WHOLE record, GNSS bracket and all.
rsrp-idx = int .size 1
rsrq-idx = int .size 1
adv = uint .size 2

; A neighbour measurement. pci is what distinguishes one from another, so it is required.
; The scalar types repeat cell's definitions under different names because zcbor derives
; generated function names from the type, and a type used at two different map keys
; collides.
neighbour = {
    1 => pci,
    ? 2 => nbr-earfcn,
    ? 3 => nbr-rsrp-idx,
    ? 4 => nbr-rsrq-idx,
    ? 5 => time-diff,
}

pci = uint .size 2
nbr-earfcn = uint .size 4
nbr-rsrp-idx = int .size 1
nbr-rsrq-idx = int .size 1
time-diff = int .size 4

access-point = {
    1 => mac,                 ; macAddress
    2 => rssi-dbm,            ; signalStrength
    ? 3 => ap-channel,        ; omitted when the driver reported 0
    ? 4 => ap-band,           ; enum wifi_frequency_bands. Only present with channel.
}

mac = bstr .size 6
rssi-dbm = int .size 1
ap-channel = uint .size 1
ap-band = uint .size 1
